{
  "description": "model-foreman guard: บังคับให้ขออนุญาตก่อนรันคำสั่งอันตราย แม้จะอยู่ใน allow list",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/guard.sh"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
